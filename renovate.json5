{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // 共通の設定 (config:recommended、dependencies ラベル、3 日寝かせる、
  // lock ファイルの週次更新など) は共有プリセットに任せる
  extends: ['github>canoypa/renovate-config'],
  timezone: 'Asia/Tokyo',
  schedule: ['on friday'],
  lockFileMaintenance: {
    schedule: ['on friday'],
  },
  packageRules: [
    {
      // pub の破壊的でない更新は 1 本の PR にまとめる
      matchManagers: ['pub'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'pub (non-major)',
    },
    {
      // 1.9 以降は今の Flutter stable でビルドできない (pubspec.yaml のコメント参照)
      matchManagers: ['pub'],
      matchPackageNames: ['receive_sharing_intent'],
      allowedVersions: '<1.9.0',
    },
    {
      // Gradle / AGP / Kotlin は Flutter が対応する組み合わせでないとビルドできない。
      // 1 本にまとめ、メジャー更新はダッシュボードで承認したときだけ PR にする
      matchManagers: ['gradle', 'gradle-wrapper'],
      groupName: 'Android build tooling',
    },
    {
      matchManagers: ['gradle', 'gradle-wrapper'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      matchManagers: ['github-actions'],
      groupName: 'GitHub Actions',
    },
  ],
}
