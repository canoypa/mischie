{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>canoypa/renovate-config"],
  "timezone": "Asia/Tokyo",
  "schedule": ["on friday"],
  "lockFileMaintenance": {
    "schedule": ["on friday"]
  },
  "packageRules": [
    {
      "description": "pub の破壊的でない更新は 1 本の PR にまとめる",
      "matchManagers": ["pub"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "pub (non-major)"
    },
    {
      "description": "receive_sharing_intent は Flutter の版によってビルドできないことがあるので、他の pub 更新とまとめず単独の PR にする。main が進むたびに追従して CI をやり直し、通った時点でマージできるようにする",
      "matchManagers": ["pub"],
      "matchPackageNames": ["receive_sharing_intent"],
      "groupName": null,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Gradle / AGP / Kotlin は Flutter が対応する組み合わせでないとビルドできないので 1 本にまとめる",
      "matchManagers": ["gradle", "gradle-wrapper"],
      "groupName": "Android build tooling"
    },
    {
      "description": "Gradle / AGP / Kotlin のメジャー更新はダッシュボードで承認したときだけ PR にする",
      "matchManagers": ["gradle", "gradle-wrapper"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "GitHub Actions の更新は 1 本の PR にまとめる",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
